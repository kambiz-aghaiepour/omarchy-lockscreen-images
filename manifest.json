{
  "schemaVersion": 1,
  "id": "io.github.kambiz.lockscreen-images",
  "name": "Lockscreen Images",
  "version": "0.1.0",
  "author": "kambiz",
  "license": "MIT",
  "description": "Photo drift for the screensaver and lock screen: point it at a folder of images, it Ken-Burns-bakes them into slow clips for the idle screensaver and streams live frames under the lock surface. Panel handles the folder, rotation, bake, and helper installation.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "LockImages.qml"
  },
  "barWidget": {
    "displayName": "Lockscreen Images",
    "description": "Screensaver/lockscreen photo drift; right-click opens the control panel",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "imagesDir": "~/Downloads/Backgrounds",
      "rotateSeconds": 60,
      "lockDrift": true,
      "screensaverDrift": true
    },
    "schema": [
      {
        "key": "imagesDir",
        "type": "string",
        "label": "Image folder",
        "defaultValue": "~/Downloads/Backgrounds"
      },
      {
        "key": "rotateSeconds",
        "type": "integer",
        "label": "Lock-frame rotation (seconds)",
        "min": 5,
        "max": 600,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "lockDrift",
        "type": "boolean",
        "label": "Live drift under the lock screen",
        "defaultValue": true
      },
      {
        "key": "screensaverDrift",
        "type": "boolean",
        "label": "Drift screensaver (off = terminal effects)",
        "defaultValue": true
      }
    ]
  }
}
